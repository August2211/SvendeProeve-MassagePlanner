<%- include("../share/header") %>
<%- include("../share/navbar") %>

<div class="treatment-form">
    <h1>Rediger behandling</h1>

    <form method="POST" action="/admin/treatments/<%= treatment.id %>/edit">
        <div class="form-group">
            <label for="name">Navn</label>
            <input id="name" type="text" name="name" value="<%= treatment.name %>" required>
        </div>

        <div class="form-group">
            <label for="price">Pris</label>
            <input id="price" type="number" name="price" min="0" step="0.01" value="<%= treatment.price %>" required>
        </div>

        <div class="form-group">
            <label for="duration_minutes">Varighed i minutter</label>
            <input id="duration_minutes" type="number" name="duration_minutes" min="1" value="<%= treatment.duration_minutes %>" required>
        </div>

        <button class="button" type="submit">Gem ændringer</button>
        <a class="button" href="/admin/treatments">Annuller</a>
    </form>
</div>

<%- include("../share/footer") %>