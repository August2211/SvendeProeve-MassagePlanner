<h1>Book behandling</h1>

<label for="treatment">Behandling:</label>

<select id="treatment" onchange="window.location.href = '/book?treatment_id=' + this.value">
    <option value="">Vælg behandling</option>

    <% treatments.forEach(treatment=> { %>
        <option value="<%= treatment.id %>" <%=selectedTreatment && selectedTreatment.id == treatment.id ? "selected" : "" %>>
            <%= treatment.name %>
        </option>
        <% }); %>
</select>


<% if (selectedTreatment) { %>
    <p>
        <%= selectedTreatment.name %> -
        <%= selectedTreatment.duration_minutes %> minutter
    </p>

    <form method="POST" action="/book">
        <input type="hidden" name="treatment_id" value="<%= selectedTreatment.id %>">
        <input type="text" name="customer_name" placeholder="Navn" required>
        <input type="email" name="customer_email" placeholder="Email" required>

        <% if (availableTimes.length > 0) { %>
            <select name="start_time" required>
                <% availableTimes.forEach(time=> { %>
                    <option value="<%= time %>">
                        <%= time.toLocaleString() %>
                    </option>
                    <% }); %>
            </select>
        <% } else { %>
            <p> No bookings available! </p>
        <% } %>

        <button type="submit">Book</button>
    </form>
    <% } %>