<%- include("share/header") %>
<%- include("share/navbar") %>

<div class="booking-form">
    <h1>Book behandling</h1>

    <div class="form-group">
        <label for="treatment">Behandling</label>

        <select id="treatment">

            <option value="">Vælg behandling</option>

            <% treatments.forEach(treatment=> { %>
                <option value="<%= treatment.id %>" <%=selectedTreatment && selectedTreatment.id == treatment.id ? "selected" : "" %>>
                    <%= treatment.name %>
                </option>
            <% }); %>
        </select>
    </div>

    <% if (selectedTreatment) { %>

        <p class="treatment-info">
            <strong><%= selectedTreatment.name %></strong>
            <br>
            <%= selectedTreatment.duration_minutes %> minutter ·
            <%= selectedTreatment.price %> kr.
        </p>

        <form method="POST" action="/book">
            <input type="hidden" name="treatment_id" value="<%= selectedTreatment.id %>">
            <div class="form-group">
                <label for="customer_name">Navn</label>
                <input id="customer_name" type="text" name="customer_name" required>
            </div>

            <div class="form-group">
                <label for="customer_email">Email</label>
                <input id="customer_email" type="email" name="customer_email" required>
            </div>

            <% if (availableTimes && availableTimes.length > 0) { %>

                <div class="form-group">
                    <label for="start_time">Ledig tid</label>

                    <select id="start_time" name="start_time" required>
                        <% availableTimes.forEach(time => { %>
                            <option value="<%= time %>">
                                <%= time.toLocaleString() %>
                            </option>
                        <% }); %>
                    </select>
                </div>

                <button class="button" type="submit">Book tid</button>

            <% } else { %>

                <p>Ingen ledige tider for denne behandling.</p>

            <% } %>
        </form>

    <% } %>
</div>

<script src="/js/book.js"></script>

<%- include("share/footer") %>